# Local development defaults. Copy to .env (gitignored). Names only in this file;
# real secrets are injected at runtime and never committed. Full list: docs/ENV_VARS.md
APP_ENV=development
# Development runs with synthetic data and canned answers, both labelled in the UI.
OPTIONS_PROVIDER=mock
LLM_PROVIDER=heuristic
AUTH_ENABLED=false
DATABASE_URL=sqlite:///./optionscoach-dev.db

# To exercise the real model locally (spends money on YOUR Anthropic account):
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# To exercise Clerk locally (MarketMosaic's Clerk development instance):
# AUTH_ENABLED=true
# CLERK_ISSUER=
# CLERK_JWKS_URL=
# CLERK_AUTHORIZED_PARTIES=http://localhost:5173
# CLERK_PUBLISHABLE_KEY=

LOG_LEVEL=INFO
